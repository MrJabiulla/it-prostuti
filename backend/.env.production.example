# Production template only. Replace placeholders using server-managed secrets.
# Do not copy the local APP_KEY or credentials to production.
APP_NAME=Prosthuti
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

# Dedicated production MySQL database; empty socket selects TCP.
DB_CONNECTION=mysql
DB_HOST=mysql.internal.example.com
DB_PORT=3306
DB_DATABASE=prosthuti_production
DB_USERNAME=prosthuti_app
DB_PASSWORD=
DB_SOCKET=
# Set the provider's CA certificate path when MySQL requires TLS.
MYSQL_ATTR_SSL_CA=

# Shared database-backed state across API instances.
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# Deployment logs go to stderr for collection by the host.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Real email delivery. smtp on port 587 uses STARTTLS when supported.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Exact HTTPS origins; web/admin/API should share the same parent domain.
FRONTEND_URLS=https://example.com,https://admin.example.com
GOOGLE_CLIENT_ID=

# Private production bucket, separate from local/test storage.
MEDIA_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
