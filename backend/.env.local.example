# Local settings. Copy to .env.local and configure once.
# Application
APP_NAME=Prosthuti
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prosthuti
DB_USERNAME=prosthuti
DB_PASSWORD=
DB_SOCKET=/tmp/prosthuti-mysql.sock

# Sessions and cache
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=false
CACHE_STORE=database

# Email OTP (log locally; configure SMTP for delivery)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend and Google login
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
GOOGLE_CLIENT_ID=

# Private media (local or r2)
MEDIA_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
